@page "/"
@rendermode InteractiveServer
@inject ArcaSimApiCliente Api
@inject DireccionesWebService DireccionesSoap

<PageTitle>ArcaSim - Portal de Facturación Electrónica</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        @* ===== Portada pública (sin sesión), al estilo de la portada de ARCA ===== *@

        @if (!_cargandoEstado && !_apiDisponible)
        {
            <div class="alert alert-warning small">
                <strong>Atención:</strong> el servicio no está disponible en este momento. Probá de nuevo en unos minutos.
            </div>
        }

        <section class="portada">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <span class="portada-etiqueta">Factura electrónica · RG 4291</span>
                    <h1 class="portada-titulo">Emití comprobantes electrónicos y obtené el CAE al instante</h1>
                    <p class="portada-bajada">
                        Con tu Clave Fiscal te inscribís como contribuyente, habilitás puntos de venta y emitís facturas A, B y C
                        con el mismo control que hace ARCA. Tu sistema también puede pedir el CAE por el web service WSFEv1.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="ingresar" class="btn btn-light btn-lg fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Ingresar con Clave Fiscal
                        </a>
                        <a href="registro" class="btn btn-outline-light btn-lg">Obtener Clave Fiscal</a>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="portada-ingreso">
                        <h2 class="h5 fw-bold mb-1">Ingresá con Clave Fiscal</h2>
                        <p class="small text-muted mb-3">Escribí tu CUIT/CUIL y en el paso siguiente tu clave.</p>

                        @* GET común: /ingresar recibe la CUIT y pasa directo a pedir la clave. *@
                        <form method="get" action="ingresar">
                            <label for="cuit-portada" class="form-label small fw-semibold">CUIT/CUIL</label>
                            <input id="cuit-portada" name="cuit" class="form-control form-control-lg font-monospace"
                                   inputmode="numeric" maxlength="13" placeholder="Ej: 20401112228" autocomplete="username" />
                            <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">Siguiente</button>
                        </form>

                        <p class="small mb-0 mt-3">
                            ¿No tenés Clave Fiscal? <a href="registro" class="fw-semibold">Obtenela acá</a>.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <h2 class="seccion-titulo">Accesos rápidos</h2>
        <div class="row g-3 mb-5">
            <div class="col-md-4">
                <a class="acceso-rapido" href="ingresar">
                    <span class="acceso-icono"><i class="bi bi-box-arrow-in-right"></i></span>
                    <span>
                        <span class="acceso-titulo">Ingresar con Clave Fiscal</span>
                        <span class="acceso-texto">Emitir comprobantes, ver tus facturas con su QR y generar la API key del web service.</span>
                    </span>
                </a>
            </div>
            <div class="col-md-4">
                <a class="acceso-rapido" href="registro">
                    <span class="acceso-icono"><i class="bi bi-person-plus"></i></span>
                    <span>
                        <span class="acceso-titulo">Obtener Clave Fiscal</span>
                        <span class="acceso-texto">Para personas humanas mayores de 18 años. Validamos tu identidad con RENAPER.</span>
                    </span>
                </a>
            </div>
            <div class="col-md-4">
                <a class="acceso-rapido" href="constatacion">
                    <span class="acceso-icono"><i class="bi bi-patch-check"></i></span>
                    <span>
                        <span class="acceso-titulo">Constatar comprobante</span>
                        <span class="acceso-texto">Verificá una factura electrónica con sus datos y el CAE, o con su código QR. No hace falta Clave Fiscal.</span>
                    </span>
                </a>
            </div>
        </div>

        <h2 class="seccion-titulo">¿Cómo empezar a facturar?</h2>
        <div class="row g-3 mb-5">
            @foreach (var (numero, titulo, texto) in Pasos)
            {
                <div class="col-sm-6 col-lg-3">
                    <div class="paso">
                        <span class="paso-numero">@numero</span>
                        <div class="paso-titulo">@titulo</div>
                        <div class="paso-texto">@texto</div>
                    </div>
                </div>
            }
        </div>

        @* ===== Documentación del web service (resumen; la guía completa está en /documentacion) ===== *@
        <section id="documentacion" class="desarrolladores">
            <div class="row g-4 align-items-center">
                <div class="col-lg-6">
                    <span class="desarrolladores-etiqueta"><i class="bi bi-code-slash me-1"></i> Documentación para desarrolladores</span>
                    <h2 class="desarrolladores-titulo">¿Tu sistema factura? Integralo con el web service WSFEv1</h2>
                    <p class="text-muted">
                        Mismo contrato SOAP que ARCA: mismas operaciones, campos y namespace. Tu sistema se autentica con la
                        API key que generás en el portal, enviada en el objeto <code>Auth</code> de cada llamada.
                    </p>

                    <ol class="desarrolladores-pasos">
                        <li><strong>Generá la API key</strong> de tu contribuyente en <em>Mis contribuyentes</em>.</li>
                        <li><strong><code>FECompUltimoAutorizado</code></strong>: el último número autorizado; el próximo es ese + 1.</li>
                        <li><strong><code>FECAESolicitar</code></strong>: mandá el comprobante y recibí el CAE con su vencimiento.</li>
                    </ol>

                    <div class="d-flex flex-wrap gap-2">
                        <a href="documentacion" class="btn btn-primary">
                            <i class="bi bi-book me-1"></i> Ver la documentación
                        </a>
                        <a href="documentacion#clientes" class="btn btn-outline-primary">Ejemplos en C#, Python y Node.js</a>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="desarrolladores-muestra">
                        <div class="muestra-etiqueta">WSDL</div>
                        <code class="muestra-url">@DireccionesSoap.Wsdl</code>

                        <div class="muestra-etiqueta mt-3">Autenticación en cada llamada</div>
                        <pre class="mb-0"><code>&lt;ar:Auth&gt;
  &lt;ar:Token&gt;TU_API_KEY&lt;/ar:Token&gt;
  &lt;ar:Sign&gt;&lt;/ar:Sign&gt;
  &lt;ar:Cuit&gt;30712345671&lt;/ar:Cuit&gt;
&lt;/ar:Auth&gt;</code></pre>
                    </div>
                </div>
            </div>
        </section>
    </NotAuthorized>

    <Authorized>
        @* ===== Tablero (con sesión) ===== *@

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-1">Portal ArcaSim</h1>
                <p class="text-muted mb-0">Simulador de ARCA (ex AFIP) para emisión, autorización y constatación de comprobantes electrónicos.</p>
            </div>
            <div>
                @if (_cargandoEstado)
                {
                    <span class="badge bg-secondary">Verificando API...</span>
                }
                else if (_apiDisponible)
                {
                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">API Online (FEDummy OK)</span>
                }
                else
                {
                    <span class="badge bg-danger">API No Disponible</span>
                }
            </div>
        </div>

        @if (!_cargandoEstado && !_apiDisponible)
        {
            <div class="alert alert-warning">
                <strong>Atención:</strong> No se pudo conectar con <code>ArcaSim.Api</code>. Asegurate de tener levantada la API en <code>http://localhost:5030</code>.
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-md-6 col-xl-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">1. Contribuyentes y API Key</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Inscribite como contribuyente o da de alta las personas jurídicas que representás, habilitá puntos de venta y generá la API Key para SOAP WSFEv1.
                        </p>
                        <a href="contribuyentes" class="btn btn-primary w-100 mt-2">Mis contribuyentes</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">2. Emitir Comprobante</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Emisión manual de Facturas A, B y C con validación de reglas de ARCA (RG 4291 / RG 5616) y obtención inmediata de CAE.
                        </p>
                        <a href="emitir" class="btn btn-primary w-100 mt-2">Emitir comprobante</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">3. Mis Comprobantes</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Consulta de comprobantes emitidos por CUIT, visualización del CAE otorgado y generación del código QR oficial de ARCA.
                        </p>
                        <a href="comprobantes" class="btn btn-primary w-100 mt-2">Ver comprobantes</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">4. Constatación Pública</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Verificación pública de facturas electrónicas ingresando sus datos + CAE o pegando la URL del código QR.
                        </p>
                        <a href="constatacion" class="btn btn-primary w-100 mt-2">Constatar factura</a>
                    </div>
                </div>
            </div>
        </div>

        @if (_contribuyentes.Count > 0)
        {
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <strong>Contribuyentes que representás (@_contribuyentes.Count)</strong>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>CUIT</th>
                                <th>Nombre / Razón Social</th>
                                <th>Persona</th>
                                <th>Condición IVA</th>
                                <th>Puntos de Venta</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _contribuyentes)
                            {
                                <tr>
                                    <td><span class="font-monospace text-dark fw-semibold">@c.Cuit</span></td>
                                    <td>@c.NombreORazonSocial</td>
                                    <td>@c.TipoPersona</td>
                                    <td><span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle">@c.CondicionIvaDescripcion</span></td>
                                    <td>
                                        @if (c.PuntosVenta.Count == 0)
                                        {
                                            <span class="badge bg-light text-secondary border">Sin PV</span>
                                        }
                                        else
                                        {
                                            @foreach (var pv in c.PuntosVenta)
                                            {
                                                <span class="badge @(pv.Habilitado ? "bg-success" : "bg-secondary") me-1">
                                                    PV @pv.Numero.ToString("D5") @(pv.Habilitado ? "" : "(Deshab.)")
                                                </span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <a href="comprobantes?cuit=@c.Cuit" class="btn btn-sm btn-link">Ver facturas</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (!_cargandoEstado && _apiDisponible)
        {
            <div class="alert alert-info">
                Todavía no representás a ningún contribuyente.
                <a href="contribuyentes" class="alert-link">Inscribite o da de alta una persona jurídica</a> para empezar a facturar.
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private static readonly (int Numero, string Titulo, string Texto)[] Pasos =
    [
        (1, "Obtené tu Clave Fiscal", "Con tu CUIT/CUIL, tu nombre como figura en el DNI y una clave. Validamos tu identidad con RENAPER."),
        (2, "Inscribite", "Como monotributista, responsable inscripto o exento. También podés dar de alta la persona jurídica que representás."),
        (3, "Habilitá un punto de venta", "Cada punto de venta tiene su propia numeración correlativa de comprobantes."),
        (4, "Emití y obtené el CAE", "Desde el portal o desde tu sistema con el web service WSFEv1 y tu API key.")
    ];

    private bool _cargandoEstado = true;
    private bool _apiDisponible;
    private List<ContribuyenteResponse> _contribuyentes = [];

    protected override async Task OnInitializedAsync()
    {
        _apiDisponible = await Api.VerificarEstadoAsync();
        bool conSesion = EstadoAutenticacion is not null &&
            (await EstadoAutenticacion).User.Identity?.IsAuthenticated == true;

        if (_apiDisponible && conSesion)
        {
            try
            {
                _contribuyentes = await Api.ListarContribuyentesAsync();
            }
            catch
            {
                _contribuyentes = [];
            }
        }
        _cargandoEstado = false;
    }
}
