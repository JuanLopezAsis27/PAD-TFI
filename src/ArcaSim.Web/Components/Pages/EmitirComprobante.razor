@page "/emitir"
@rendermode InteractiveServer
@inject ArcaSimApiCliente Api

<PageTitle>Emitir Comprobante · ArcaSim</PageTitle>

<h2 class="mb-3">Emitir Comprobante Electrónico (Solicitud de CAE)</h2>

@if (!string.IsNullOrWhiteSpace(_errorGeneral))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <strong>Error:</strong> @_errorGeneral
        <button type="button" class="btn-close" @onclick="() => _errorGeneral = null"></button>
    </div>
}

@if (_resultado is not null)
{
    @if (_resultado.EstadoAutorizacion is "Autorizado" or "AutorizadoConObservaciones")
    {
        <div class="alert alert-success shadow-sm mb-4">
            <h5 class="alert-heading mb-1">Comprobante Autorizado — Resultado: A</h5>
            <p class="mb-2">
                <strong>@_resultado.TipoComprobanteDescripcion</strong>
                N° <span class="font-monospace text-dark fw-semibold">@_resultado.PuntoVentaNumero.ToString("D5")-@_resultado.Numero.ToString("D8")</span> ·
                CAE: <span class="font-monospace text-dark fw-semibold fs-5">@_resultado.Cae</span> ·
                Vencimiento CAE: <strong>@_resultado.FechaVencimientoCae?.ToString("dd/MM/yyyy")</strong>
            </p>
            <div class="d-flex gap-2">
                <a href="comprobantes/@_resultado.CuitEmisor/@_resultado.PuntoVentaNumero/@_resultado.TipoComprobante/@_resultado.Numero"
                   class="btn btn-sm btn-success">
                    Ver Comprobante y Código QR
                </a>
                <a href="comprobantes?cuit=@_resultado.CuitEmisor" class="btn btn-sm btn-outline-success">
                    Ir a Mis Comprobantes
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger shadow-sm mb-4">
            <h5 class="alert-heading mb-2">Comprobante Rechazado por ARCA — Resultado: R</h5>
            <p class="small mb-2">El comprobante no superó las validaciones del Manual del Desarrollador WSFEv1:</p>
            <ul class="mb-0">
                @foreach (var err in _resultado.Errores)
                {
                    <li><strong>Código @err.Codigo:</strong> @err.Descripcion</li>
                }
            </ul>
        </div>
    }
}

<div class="card shadow-sm">
    <div class="card-body">
        <!-- 1. Datos del Emisor y Comprobante -->
        <h5 class="border-bottom pb-2 mb-3">1. Emisor y Datos del Comprobante</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <label class="form-label fw-semibold">Contribuyente Emisor</label>
                <select class="form-select" value="@_pedido.CuitEmisor" @onchange="OnContribuyenteCambiadoAsync">
                    @foreach (var c in _contribuyentes)
                    {
                        <option value="@c.Cuit">@c.NombreORazonSocial (@c.Cuit) - @c.CondicionIvaDescripcion</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Punto de Venta</label>
                <select class="form-select" value="@_pedido.PuntoVentaNumero" @onchange="OnPuntoVentaCambiadoAsync">
                    @if (_contribuyenteActual is not null)
                    {
                        @foreach (var pv in _contribuyenteActual.PuntosVenta)
                        {
                            <option value="@pv.Numero">
                                @pv.Numero.ToString("D5") @(pv.Habilitado ? "" : "(Deshab.)")
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">Tipo de Comprobante</label>
                <select class="form-select" value="@_pedido.TipoComprobante" @onchange="OnTipoComprobanteCambiadoAsync">
                    @if (!EsEmisorMonotributistaOExento || _editarImportesManualmente)
                    {
                        <option value="1">001 - Factura A</option>
                        <option value="2">002 - Nota de Débito A</option>
                        <option value="3">003 - Nota de Crédito A</option>
                        <option value="6">006 - Factura B</option>
                        <option value="7">007 - Nota de Débito B</option>
                        <option value="8">008 - Nota de Crédito B</option>
                    }
                    @if (EsEmisorMonotributistaOExento || _editarImportesManualmente)
                    {
                        <option value="11">011 - Factura C</option>
                        <option value="12">012 - Nota de Débito C</option>
                        <option value="13">013 - Nota de Crédito C</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Próximo Número</label>
                <input type="number" class="form-control" @bind="_pedido.Numero" min="1" />
                <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Sugerido correlativo (editable para pruebas)</small>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Concepto</label>
                <select class="form-select" @bind="_pedido.Concepto">
                    <option value="1">1 - Productos</option>
                    <option value="2">2 - Servicios</option>
                    <option value="3">3 - Productos y Servicios</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Fecha de Emisión</label>
                <input type="date" class="form-control" @bind="_fechaEmision" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Moneda</label>
                <select class="form-select" @bind="_pedido.Moneda" @bind:after="OnMonedaCambiada">
                    <option value="PES">PES - Pesos</option>
                    <option value="DOL">DOL - Dólares</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Cotización</label>
                <input type="number" step="0.01"
                       class="form-control @(EsMonedaPesos ? "bg-light" : "")"
                       readonly="@EsMonedaPesos"
                       @bind="_pedido.Cotizacion" />
            </div>

            @if (_pedido.Concepto is 2 or 3)
            {
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Servicio Desde</label>
                    <input type="date" class="form-control" @bind="_fechaServicioDesde" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Servicio Hasta</label>
                    <input type="date" class="form-control" @bind="_fechaServicioHasta" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Vencimiento de Pago</label>
                    <input type="date" class="form-control" @bind="_fechaVencimientoPago" />
                </div>
            }
        </div>

        <!-- 2. Datos del Receptor -->
        <h5 class="border-bottom pb-2 mb-3">2. Datos del Receptor (RG 5616)</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Condición frente al IVA del Receptor</label>
                <select class="form-select" @bind="_pedido.CondicionIvaReceptor">
                    <option value="1">1 - IVA Responsable Inscripto</option>
                    <option value="6">6 - Responsable Monotributo</option>
                    <option value="5">5 - Consumidor Final</option>
                    <option value="4">4 - IVA Sujeto Exento</option>
                    <option value="13">13 - Monotributista Social</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Tipo de Documento</label>
                <select class="form-select" @bind="_pedido.TipoDocumentoReceptor" @bind:after="OnTipoDocumentoCambiado">
                    <option value="80">80 - CUIT</option>
                    <option value="86">86 - CUIL</option>
                    <option value="96">96 - DNI</option>
                    <option value="99">99 - Sin identificar (Consumidor Final)</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Número de Documento (0 si es 99)</label>
                <input class="form-control @(EsConsumidorFinalSinIdentificar ? "bg-light" : "")"
                       disabled="@EsConsumidorFinalSinIdentificar"
                       @bind="_pedido.NumeroDocumentoReceptor"
                       placeholder="Ej: 27287654311 o 0" />
            </div>
        </div>

        <!-- 3. Importes e IVA -->
        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
            <h5 class="mb-0">3. Importes y Alícuotas de IVA</h5>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AutocalcularImportes">
                Recalcular IVA y Total automáticamente
            </button>
        </div>

        <div class="row g-3 mb-2">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Importe Neto Gravado</label>
                <input type="number" step="0.01" class="form-control"
                       @bind="_pedido.ImporteNeto"
                       @bind:after="AutocalcularImportesSiCorresponde" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">Alícuota de IVA principal</label>
                <select class="form-select"
                        disabled="@(EsClaseC(_pedido.TipoComprobante) || EsEmisorMonotributistaOExento)"
                        @bind="_alicuotaSeleccionada"
                        @bind:after="AutocalcularImportesSiCorresponde">
                    <option value="5">5 - 21%</option>
                    <option value="4">4 - 10,5%</option>
                    <option value="6">6 - 27%</option>
                    <option value="8">8 - 5%</option>
                    <option value="9">9 - 2,5%</option>
                    <option value="3">3 - 0%</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Importe IVA</label>
                <input type="number" step="0.01"
                       class="form-control @(!_editarImportesManualmente ? "bg-light fw-semibold" : "")"
                       readonly="@(!_editarImportesManualmente)"
                       @bind="_pedido.ImporteIva" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Importe Exento</label>
                <input type="number" step="0.01"
                       class="form-control @(EsClaseC(_pedido.TipoComprobante) && !_editarImportesManualmente ? "bg-light" : "")"
                       disabled="@(EsClaseC(_pedido.TipoComprobante) && !_editarImportesManualmente)"
                       @bind="_pedido.ImporteExento"
                       @bind:after="AutocalcularImportesSiCorresponde" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Importe Total</label>
                <input type="number" step="0.01"
                       class="form-control @(!_editarImportesManualmente ? "bg-light fw-semibold" : "fw-bold")"
                       readonly="@(!_editarImportesManualmente)"
                       @bind="_pedido.ImporteTotal" />
            </div>
        </div>

        <div class="form-check mt-2 mb-3">
            <input class="form-check-input" type="checkbox" id="chkEditarManual"
                   @bind="_editarImportesManualmente"
                   @bind:after="OnModoManualCambiado" />
            <label class="form-check-label small text-muted" for="chkEditarManual">
                Editar importes manualmente (permite forzar diferencias de IVA / Total para probar rechazos de ARCA)
            </label>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <button class="btn btn-primary px-4" @onclick="EmitirAsync" disabled="@_enviando">
                @(_enviando ? "Solicitando CAE..." : "Solicitar CAE y Emitir Comprobante")
            </button>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "cuit")]
    public string? CuitQuery { get; set; }

    private List<ContribuyenteResponse> _contribuyentes = [];
    private ContribuyenteResponse? _contribuyenteActual;

    private readonly EmitirComprobanteRequest _pedido = new()
    {
        PuntoVentaNumero = 1,
        TipoComprobante = 1,
        Concepto = 1,
        TipoDocumentoReceptor = 80,
        NumeroDocumentoReceptor = "27287654311",
        CondicionIvaReceptor = 6,
        ImporteNeto = 10000m,
        ImporteIva = 2100m,
        ImporteTotal = 12100m,
        Moneda = "PES",
        Cotizacion = 1m
    };

    private int _alicuotaSeleccionada = 5;
    private bool _editarImportesManualmente;
    private DateTime _fechaEmision = DateTime.Today;
    private DateTime _fechaServicioDesde = DateTime.Today.AddDays(-15);
    private DateTime _fechaServicioHasta = DateTime.Today;
    private DateTime _fechaVencimientoPago = DateTime.Today.AddDays(10);

    private bool _enviando;
    private string? _errorGeneral;
    private ComprobanteResponse? _resultado;

    private bool EsEmisorMonotributistaOExento => _contribuyenteActual is not null && _contribuyenteActual.CondicionIva != 1;
    private bool EsConsumidorFinalSinIdentificar => _pedido.TipoDocumentoReceptor == 99;
    private bool EsMonedaPesos => string.Equals(_pedido.Moneda, "PES", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _contribuyentes = await Api.ListarContribuyentesAsync();
        if (_contribuyentes.Count > 0)
        {
            var inicial = !string.IsNullOrWhiteSpace(CuitQuery)
                ? _contribuyentes.FirstOrDefault(c => c.Cuit == CuitQuery) ?? _contribuyentes[0]
                : _contribuyentes[0];

            await SeleccionarContribuyenteAsync(inicial);
        }
    }

    private async Task SeleccionarContribuyenteAsync(ContribuyenteResponse c)
    {
        _contribuyenteActual = c;
        _pedido.CuitEmisor = c.Cuit;
        _pedido.PuntoVentaNumero = c.PuntosVenta.FirstOrDefault(p => p.Habilitado)?.Numero
            ?? c.PuntosVenta.FirstOrDefault()?.Numero
            ?? 1;

        if (c.CondicionIva == 1)
        {
            // Responsable Inscripto -> por defecto Factura A
            _pedido.TipoComprobante = 1;
            _pedido.TipoDocumentoReceptor = 80;
            _pedido.NumeroDocumentoReceptor = "27287654311";
            _pedido.CondicionIvaReceptor = 6;
        }
        else
        {
            // Monotributista o Exento -> Factura C (011) a Consumidor Final
            _pedido.TipoComprobante = 11;
            _pedido.TipoDocumentoReceptor = 99;
            _pedido.NumeroDocumentoReceptor = "0";
            _pedido.CondicionIvaReceptor = 5;
        }

        AutocalcularImportes();
        await ActualizarProximoNumeroAsync();
    }

    private async Task OnContribuyenteCambiadoAsync(ChangeEventArgs e)
    {
        var cuit = e.Value?.ToString();
        var encontrado = _contribuyentes.FirstOrDefault(c => c.Cuit == cuit);
        if (encontrado is not null)
            await SeleccionarContribuyenteAsync(encontrado);
    }

    private async Task OnPuntoVentaCambiadoAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var pv))
        {
            _pedido.PuntoVentaNumero = pv;
            await ActualizarProximoNumeroAsync();
        }
    }

    private async Task OnTipoComprobanteCambiadoAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var tipo))
        {
            _pedido.TipoComprobante = tipo;
            if (EsClaseB(tipo) || EsClaseC(tipo))
            {
                _pedido.CondicionIvaReceptor = 5;
                _pedido.TipoDocumentoReceptor = 99;
                _pedido.NumeroDocumentoReceptor = "0";
            }
            else if (EsClaseA(tipo))
            {
                _pedido.CondicionIvaReceptor = 6;
                _pedido.TipoDocumentoReceptor = 80;
                if (_pedido.NumeroDocumentoReceptor == "0")
                    _pedido.NumeroDocumentoReceptor = "27287654311";
            }

            AutocalcularImportes();
            await ActualizarProximoNumeroAsync();
        }
    }

    private void OnTipoDocumentoCambiado()
    {
        if (_pedido.TipoDocumentoReceptor == 99)
        {
            _pedido.NumeroDocumentoReceptor = "0";
        }
        else if (_pedido.NumeroDocumentoReceptor == "0")
        {
            _pedido.NumeroDocumentoReceptor = string.Empty;
        }
    }

    private void OnMonedaCambiada()
    {
        if (EsMonedaPesos)
        {
            _pedido.Cotizacion = 1m;
        }
    }

    private void OnModoManualCambiado()
    {
        if (!_editarImportesManualmente)
        {
            AutocalcularImportes();
        }
    }

    private void AutocalcularImportesSiCorresponde()
    {
        if (!_editarImportesManualmente)
        {
            AutocalcularImportes();
        }
    }

    private async Task ActualizarProximoNumeroAsync()
    {
        if (!string.IsNullOrWhiteSpace(_pedido.CuitEmisor))
        {
            _pedido.Numero = await Api.ObtenerProximoNumeroAsync(
                _pedido.CuitEmisor,
                _pedido.PuntoVentaNumero,
                _pedido.TipoComprobante);
        }
    }

    private void AutocalcularImportes()
    {
        if (EsClaseC(_pedido.TipoComprobante) || EsEmisorMonotributistaOExento)
        {
            _pedido.ImporteIva = 0m;
            _pedido.ImporteExento = 0m;
            _pedido.ImporteNoGravado = 0m;
            _pedido.ImporteTotal = decimal.Round(_pedido.ImporteNeto + _pedido.ImporteTributos, 2);
        }
        else
        {
            decimal porcentaje = _alicuotaSeleccionada switch
            {
                3 => 0m,
                4 => 0.105m,
                5 => 0.21m,
                6 => 0.27m,
                8 => 0.05m,
                9 => 0.025m,
                _ => 0.21m
            };

            _pedido.ImporteIva = decimal.Round(_pedido.ImporteNeto * porcentaje, 2);
            _pedido.ImporteTotal = decimal.Round(
                _pedido.ImporteNeto + _pedido.ImporteIva + _pedido.ImporteExento + _pedido.ImporteNoGravado + _pedido.ImporteTributos,
                2);
        }
    }

    private async Task EmitirAsync()
    {
        _errorGeneral = null;
        _resultado = null;
        _enviando = true;

        try
        {
            if (EsMonedaPesos)
                _pedido.Cotizacion = 1m;

            if (EsConsumidorFinalSinIdentificar)
                _pedido.NumeroDocumentoReceptor = "0";

            _pedido.Fecha = _fechaEmision;
            if (_pedido.Concepto is 2 or 3)
            {
                _pedido.FechaServicioDesde = _fechaServicioDesde;
                _pedido.FechaServicioHasta = _fechaServicioHasta;
                _pedido.FechaVencimientoPago = _fechaVencimientoPago;
            }
            else
            {
                _pedido.FechaServicioDesde = null;
                _pedido.FechaServicioHasta = null;
                _pedido.FechaVencimientoPago = null;
            }

            if (EsClaseC(_pedido.TipoComprobante))
            {
                _pedido.AlicuotasIva = [];
            }
            else if (_pedido.ImporteNeto > 0)
            {
                _pedido.AlicuotasIva =
                [
                    new AlicuotaIvaDto
                    {
                        AlicuotaId = _alicuotaSeleccionada,
                        BaseImponible = _pedido.ImporteNeto,
                        ImporteIva = _pedido.ImporteIva
                    }
                ];
            }
            else
            {
                _pedido.AlicuotasIva = [];
            }

            var (comprobante, error) = await Api.EmitirComprobanteAsync(_pedido);
            if (error is not null)
            {
                _errorGeneral = error;
                return;
            }

            _resultado = comprobante;
            if (_resultado?.EstadoAutorizacion is "Autorizado" or "AutorizadoConObservaciones")
            {
                await ActualizarProximoNumeroAsync();
            }
        }
        finally
        {
            _enviando = false;
        }
    }

    private static bool EsClaseA(int tipo) => tipo is 1 or 2 or 3;
    private static bool EsClaseB(int tipo) => tipo is 6 or 7 or 8;
    private static bool EsClaseC(int tipo) => tipo is 11 or 12 or 13;
}
